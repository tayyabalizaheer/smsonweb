{
  "name": "SMS Sync Messenger",
  "short_name": "SMS Sync",
  "description": "Installable SMS synchronization dashboard.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef1f4",
  "theme_color": "#0f8f7f",
  "orientation": "portrait-primary",
  "display_override": ["standalone"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
