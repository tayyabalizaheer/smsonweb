<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <main class="messenger-shell">
      <aside class="conversation-panel" aria-label="Conversations">
        <header class="app-header">
          <div>
            <p class="eyebrow">SMS Sync</p>
            <h1>Messages</h1>
          </div>
          <div class="sync-meta">
            <strong><%= totalMessages %></strong>
            <span>messages</span>
          </div>
        </header>

        <section class="last-sync" aria-label="Last sync">
          <span>Last sync</span>
          <% if (lastSyncedAt) { %>
            <time datetime="<%= new Date(lastSyncedAt).toISOString() %>">
              <%= new Intl.DateTimeFormat('en', {
                dateStyle: 'medium',
                timeStyle: 'short'
              }).format(new Date(lastSyncedAt)) %>
            </time>
          <% } else { %>
            <strong>Never</strong>
          <% } %>
        </section>

        <% if (conversations.length === 0) { %>
          <section class="empty-panel">
            <h2>No messages yet</h2>
            <p>Old and new SMS messages from the Android app will appear here after sync.</p>
          </section>
        <% } else { %>
          <nav class="conversation-list">
            <% conversations.forEach((conversation) => { %>
              <% const active = selectedConversation && conversation.address === selectedConversation.address; %>
              <a class="conversation-link <%= active ? 'is-active' : '' %>" href="/?address=<%= encodeURIComponent(conversation.address) %>">
                <span class="avatar" aria-hidden="true"><%= conversation.displayName.slice(0, 1).toUpperCase() %></span>
                <span class="conversation-copy">
                  <strong><%= conversation.displayName %></strong>
                  <em><%= conversation.contactEmail || conversation.address %></em>
                  <small><%= conversation.latestMessage.body %></small>
                </span>
                <span class="conversation-stats">
                  <time datetime="<%= new Date(conversation.latestMessage.messageAt).toISOString() %>">
                    <%= new Intl.DateTimeFormat('en', {
                      month: 'short',
                      day: 'numeric'
                    }).format(new Date(conversation.latestMessage.messageAt)) %>
                  </time>
                  <small><%= conversation.receivedCount %> in / <%= conversation.sentCount %> out</small>
                </span>
              </a>
            <% }) %>
          </nav>
        <% } %>
      </aside>

      <section class="thread-panel" aria-label="Selected conversation">
        <% if (!selectedConversation) { %>
          <div class="thread-empty">
            <h2>Select a conversation</h2>
            <p>Synced SMS conversations will be shown here.</p>
          </div>
        <% } else { %>
          <header class="thread-header">
            <span class="avatar large" aria-hidden="true"><%= selectedConversation.displayName.slice(0, 1).toUpperCase() %></span>
            <div>
              <h2><%= selectedConversation.displayName %></h2>
              <p><%= selectedConversation.contactEmail || selectedConversation.address %></p>
            </div>
          </header>

          <div class="message-thread">
            <% selectedMessages.forEach((message) => { %>
              <% const isSent = message.direction === 'sent'; %>
              <article class="bubble-row <%= isSent ? 'is-sent' : 'is-received' %>">
                <div class="message-bubble">
                  <p><%= message.body %></p>
                  <footer>
                    <span><%= isSent ? 'Sent' : 'Received' %></span>
                    <time datetime="<%= new Date(message.messageAt).toISOString() %>">
                      <%= new Intl.DateTimeFormat('en', {
                        dateStyle: 'medium',
                        timeStyle: 'short'
                      }).format(new Date(message.messageAt)) %>
                    </time>
                  </footer>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
