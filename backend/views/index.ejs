<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0f8f7f">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="SMS Sync">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title><%= title %></title>
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <main class="messenger-shell" data-thread-address="">
      <aside class="conversation-panel" aria-label="Conversations">
        <header class="app-header">
          <div>
            <p class="eyebrow">SMS Sync</p>
            <h1>Messages</h1>
          </div>
          <div class="sync-meta">
            <strong><%= totalMessages %></strong>
            <span>messages</span>
          </div>
        </header>

        <section class="last-sync" aria-label="Last sync">
          <span>Last sync</span>
          <% if (lastSyncedAt) { %>
            <time datetime="<%= new Date(lastSyncedAt).toISOString() %>">
              <%= new Intl.DateTimeFormat('en', {
                dateStyle: 'medium',
                timeStyle: 'short'
              }).format(new Date(lastSyncedAt)) %>
            </time>
          <% } else { %>
            <strong>Never</strong>
          <% } %>
        </section>

        <% if (conversations.length === 0) { %>
          <section class="empty-panel">
            <h2>No messages yet</h2>
            <p>Old and new SMS messages from the Android app will appear here after sync.</p>
          </section>
        <% } else { %>
          <nav class="conversation-list">
            <% conversations.forEach((conversation) => { %>
              <a
                class="conversation-link"
                href="/?address=<%= encodeURIComponent(conversation.address) %>"
                data-address="<%= conversation.address %>"
                data-display-name="<%= conversation.displayName %>"
                data-contact-email="<%= conversation.contactEmail || '' %>">
                <span class="avatar" aria-hidden="true"><%= conversation.displayName.slice(0, 1).toUpperCase() %></span>
                <span class="conversation-copy">
                  <strong><%= conversation.displayName %></strong>
                  <em><%= conversation.contactEmail || conversation.address %></em>
                  <small><%= conversation.latestMessage.body %></small>
                </span>
                <span class="conversation-stats">
                  <time datetime="<%= new Date(conversation.latestMessage.messageAt).toISOString() %>">
                    <%= new Intl.DateTimeFormat('en', {
                      month: 'short',
                      day: 'numeric'
                    }).format(new Date(conversation.latestMessage.messageAt)) %>
                  </time>
                  <small><%= conversation.receivedCount %> in / <%= conversation.sentCount %> out</small>
                </span>
              </a>
            <% }) %>
          </nav>
        <% } %>
      </aside>

      <section class="thread-panel" aria-label="Selected conversation">
        <header class="thread-header is-empty">
          <a class="thread-back" href="/" aria-label="Back to contacts">
            <span aria-hidden="true">&larr;</span>
            <strong>Back</strong>
          </a>
          <span class="avatar large" aria-hidden="true">#</span>
          <div>
            <h2>Select a contact</h2>
            <p>Choose a conversation to load the latest messages.</p>
          </div>
        </header>

        <div class="message-thread" data-empty="true">
          <div class="thread-empty">
            <h2>Select a conversation</h2>
            <p>Only the contact list loads first. Messages load when you open a contact.</p>
          </div>
        </div>
      </section>
    </main>
    <script src="/js/app.js" defer></script>
  </body>
</html>
