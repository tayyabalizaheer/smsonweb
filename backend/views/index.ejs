<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0f8f7f">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="SMS Sync">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title><%= title %></title>
    <link rel="manifest" href="/manifest.webmanifest?v=<%= encodeURIComponent(appVersion) %>">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="stylesheet" href="/css/styles.css?v=<%= encodeURIComponent(appVersion) %>">
  </head>
  <body>
    <main
      class="messenger-shell"
      data-thread-address=""
      data-device-code="<%= device.code %>"
      data-app-version="<%= appVersion %>"
      data-latest-sync="<%= lastSyncedAt ? new Date(lastSyncedAt).toISOString() : '' %>">
      <aside class="conversation-panel" aria-label="Conversations">
        <header class="app-header">
          <div class="app-title">
            <h1>
              <span class="status-dot <%= device.lastPingAt && (Date.now() - new Date(device.lastPingAt).getTime() <= 120000) ? 'is-online' : 'is-offline' %>" aria-hidden="true"></span>
              <span>SMS SYNC</span>
            </h1>
          </div>
          <button class="settings-button" type="button" aria-label="Open settings" aria-haspopup="dialog" aria-expanded="false" aria-controls="settingsPanel">
            <span aria-hidden="true">&#9881;</span>
          </button>
        </header>

        <section class="settings-panel" id="settingsPanel" role="dialog" aria-modal="true" aria-labelledby="settingsTitle" hidden>
          <div class="settings-backdrop" data-settings-close aria-hidden="true"></div>
          <div class="settings-card" tabindex="-1">
            <header class="settings-modal-header">
              <div>
                <p class="eyebrow">SMS Sync</p>
                <h2 id="settingsTitle">Settings</h2>
              </div>
              <button class="settings-close-button" type="button" aria-label="Close settings" data-settings-close>&times;</button>
            </header>

            <div class="settings-row">
              <span>Device</span>
              <strong><%= device.code %></strong>
            </div>
            <div class="settings-row">
              <span>Status</span>
              <strong data-device-status><%= device.lastPingAt && (Date.now() - new Date(device.lastPingAt).getTime() <= 120000) ? 'Online' : 'Offline' %></strong>
            </div>
            <div class="settings-row">
              <span>Last ping</span>
              <strong data-device-last-ping>
                <% if (device.lastPingAt) { %>
                  <%= new Intl.DateTimeFormat('en', { timeStyle: 'medium' }).format(new Date(device.lastPingAt)) %>
                <% } else { %>
                  Never
                <% } %>
              </strong>
            </div>
            <div class="settings-row">
              <span>Messages</span>
              <strong><%= totalMessages %></strong>
            </div>
            <div class="settings-row">
              <span>Last sync</span>
              <% if (lastSyncedAt) { %>
                <time datetime="<%= new Date(lastSyncedAt).toISOString() %>">
                  <%= new Intl.DateTimeFormat('en', {
                    dateStyle: 'medium',
                    timeStyle: 'short'
                  }).format(new Date(lastSyncedAt)) %>
                </time>
              <% } else { %>
                <strong>Never</strong>
              <% } %>
            </div>
            <div class="settings-row">
              <span>Notifications</span>
              <button class="notification-button" type="button" data-notification-button>Enable</button>
            </div>
            <div class="settings-row">
              <span>App version</span>
              <strong data-update-status>v<%= appVersion %></strong>
            </div>
            <div class="settings-row">
              <span>Update</span>
              <button class="notification-button" type="button" data-update-button>Check</button>
            </div>
            <form class="logout-form" action="/logout" method="post">
              <button type="submit">Unpair this browser</button>
            </form>
          </div>
        </section>

        <div class="pull-refresh-indicator" data-pull-refresh hidden>
          <span></span>
          <strong>Refreshing...</strong>
        </div>

        <% if (conversations.length === 0) { %>
          <section class="empty-panel">
            <h2>No messages yet</h2>
            <p>Old and new SMS messages from the Android app will appear here after sync.</p>
          </section>
        <% } else { %>
          <nav class="conversation-list">
            <% conversations.forEach((conversation) => { %>
              <div class="conversation-item" data-address="<%= conversation.address %>">
                <button class="conversation-delete-button" type="button" data-delete-conversation="<%= conversation.address %>">Delete</button>
                <a
                  class="conversation-link"
                  href="/?address=<%= encodeURIComponent(conversation.address) %>"
                  data-address="<%= conversation.address %>"
                  data-display-name="<%= conversation.displayName %>"
                  data-contact-email="<%= conversation.contactEmail || '' %>"
                  data-latest-message-at="<%= new Date(conversation.latestMessage.messageAt).toISOString() %>">
                  <span class="avatar" aria-hidden="true"><%= conversation.displayName.slice(0, 1).toUpperCase() %></span>
                  <span class="conversation-copy">
                    <strong><%= conversation.displayName %></strong>
                    <% if ((conversation.contactEmail || conversation.address) !== conversation.displayName) { %>
                      <em><%= conversation.contactEmail || conversation.address %></em>
                    <% } %>
                    <small><%= conversation.latestMessage.body %></small>
                  </span>
                  <% if (conversation.unreadCount > 0) { %>
                    <span class="unread-badge" data-unread-badge><%= conversation.unreadCount > 99 ? '99+' : conversation.unreadCount %></span>
                  <% } %>
                </a>
              </div>
            <% }) %>
          </nav>
        <% } %>
      </aside>

      <section class="thread-panel" aria-label="Selected conversation">
        <header class="thread-header is-empty">
          <a class="thread-back" href="/" aria-label="Back to contacts">
            <span aria-hidden="true">&larr;</span>
            <strong>Back</strong>
          </a>
          <span class="avatar large" aria-hidden="true">#</span>
          <div>
            <h2>Select a contact</h2>
            <p>Choose a conversation to load the latest messages.</p>
          </div>
        </header>

        <div class="message-thread" data-empty="true">
          <div class="thread-empty">
            <h2>Select a conversation</h2>
            <p>Only the contact list loads first. Messages load when you open a contact.</p>
          </div>
        </div>
      </section>
    </main>
    <div class="undo-toast" data-undo-toast hidden>
      <span data-undo-message>Deleted</span>
      <button type="button" data-undo-button>Undo</button>
    </div>
    <script src="/js/app.js?v=<%= encodeURIComponent(appVersion) %>" defer></script>
  </body>
</html>
