generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Message {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sender     String   @db.VarChar(64)
  body       String   @db.Text
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamp(0)

  @@index([receivedAt])
  @@index([sender])
  @@map("messages")
}
